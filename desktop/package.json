{
  "name": "raven-phone",
  "productName": "Raven Phone",
  "version": "1.3.0",
  "private": true,
  "description": "Raven Phone desktop",
  "author": "Raven PBX",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.ravenpbx.phone",
    "productName": "Raven Phone",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RavenPhone.exe",
      "signAndEditExecutable": false
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "artifactName": "RavenPhone-mac-${arch}.dmg"
    }
  }
}
